rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tripPath(tripId) { return /databases/$(database)/documents/trips/$(tripId); }
    function member(tripId) { return signedIn() && request.auth.uid in get(tripPath(tripId)).data.memberIds; }
    function owner(tripId) { return signedIn() && get(tripPath(tripId)).data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(tripPath(request.resource.data.tripId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && member(resource.data.tripId);
    }

    match /publicTrips/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && member(request.resource.data.sourceTripId)
        && request.resource.data.ownerId == get(tripPath(request.resource.data.sourceTripId)).data.ownerId
        && request.resource.data.keys().hasOnly([
          'sourceTripId', 'ownerId', 'name', 'destination', 'startDate', 'endDate',
          'emoji', 'places', 'includeNotes', 'notes', 'publishedAt', 'updatedAt'
        ])
      allow delete: if signedIn() && member(resource.data.sourceTripId);
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      // This is queryable with `where('memberIds', 'array-contains', uid)`.
      // Reading the same document through get() is not query-provable.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if (
        member(tripId)
        && request.resource.data.ownerId == resource.data.ownerId
      ) || (
        signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && exists(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode))
        && get(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode)).data.tripId == tripId
      );
      allow delete: if member(tripId);

      match /members/{memberId} {
        allow read: if member(tripId);
        allow create: if member(tripId) || (
          signedIn() && request.auth.uid == memberId
          && request.auth.uid in getAfter(tripPath(tripId)).data.memberIds
        );
        allow update, delete: if member(tripId);
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /attachments/{attachmentId} {
        allow read, create, update, delete: if member(tripId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if member(tripId);
        }
      }
      match /places/{placeId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /segments/{segmentId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /messages/{messageId} {
        allow read: if member(tripId);
        allow create: if member(tripId) && request.resource.data.author.id == request.auth.uid;
        allow update, delete: if member(tripId);
      }
      match /proposals/{proposalId} {
        allow read, create, update: if member(tripId);
        allow delete: if member(tripId);

        match /votes/{userId} {
          allow read: if member(tripId);
          allow create, update: if member(tripId) && request.auth.uid == userId;
          allow delete: if member(tripId);
        }
      }
    }
  }
}
