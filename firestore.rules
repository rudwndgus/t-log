rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tripPath(tripId) { return /databases/$(database)/documents/trips/$(tripId); }
    function member(tripId) { return signedIn() && request.auth.uid in get(tripPath(tripId)).data.memberIds; }
    function owner(tripId) { return signedIn() && get(tripPath(tripId)).data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(tripPath(request.resource.data.tripId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && owner(resource.data.tripId);
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if member(tripId);
      allow update: if (
        member(tripId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (owner(tripId) || request.resource.data.memberIds == resource.data.memberIds)
      ) || (
        signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && exists(/databases/$(database)/documents/inviteCodes/$(resource.data.inviteCode))
      );
      allow delete: if owner(tripId);

      match /members/{memberId} {
        allow read: if member(tripId);
        allow create: if owner(tripId) || (
          signedIn() && request.auth.uid == memberId
          && request.auth.uid in getAfter(tripPath(tripId)).data.memberIds
        );
        allow update: if owner(tripId) || (member(tripId) && request.auth.uid == memberId);
        allow delete: if owner(tripId);
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /places/{placeId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /segments/{segmentId} {
        allow read, create, update, delete: if member(tripId);
      }
      match /messages/{messageId} {
        allow read: if member(tripId);
        allow create: if member(tripId) && request.resource.data.author.id == request.auth.uid;
        allow update, delete: if false;
      }
      match /proposals/{proposalId} {
        allow read, create, update: if member(tripId);
        allow delete: if owner(tripId) || (member(tripId) && resource.data.createdBy == request.auth.uid);

        match /votes/{userId} {
          allow read: if member(tripId);
          allow create, update, delete: if member(tripId) && request.auth.uid == userId;
        }
      }
    }
  }
}
